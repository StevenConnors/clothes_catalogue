{
  "name": "personal-wardrobe",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && python3 -m unittest discover -s tests/pipeline -p \"test_*.py\"",
    "test:e2e": "playwright test",
    "wardrobe:indexes": "tsx scripts/setup-indexes.ts",
    "wardrobe:import": "tsx scripts/import-batch.ts"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "dotenv": "18.0.4",
    "mongodb": "7.6.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
